rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && (
          get(couplePath(coupleId)).data.memberA == request.auth.uid
          || get(couplePath(coupleId)).data.memberB == request.auth.uid
        );
    }

    function isActiveCoupleMember(coupleId) {
      return signedIn()
        && get(couplePath(coupleId)).data.status == 'active'
        && (
          get(couplePath(coupleId)).data.memberA == request.auth.uid
          || get(couplePath(coupleId)).data.memberB == request.auth.uid
        );
    }

    match /users/{uid} {
      // Own profile, or the profile of the other member of the same active couple.
      // This is intentionally get-only: the app uses a document snapshot listener,
      // so realtime profile updates do not require collection/list permission.
      allow get: if signedIn() && (
        request.auth.uid == uid
        || (
          get(userPath(request.auth.uid)).data.pairId is string
          && isActiveCoupleMember(get(userPath(request.auth.uid)).data.pairId)
          && (
            get(couplePath(get(userPath(request.auth.uid)).data.pairId)).data.memberA == uid
            || get(couplePath(get(userPath(request.auth.uid)).data.pairId)).data.memberB == uid
          )
        )
      );

      allow list: if false;

      // Profile photo fields are optional. Existing users created before Phase 2
      // remain valid because absent optional fields are not required here.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'photoUrl', 'photoPath', 'pairId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.pairId == null
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && (!('photoPath' in request.resource.data) || request.resource.data.photoPath == null || request.resource.data.photoPath is string);

      allow update: if signedIn() && (
        // The owner may update their display name/profile photo and pair state.
        (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl', 'photoPath', 'pairId', 'updatedAt'])
          && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
          && (!('photoPath' in request.resource.data) || request.resource.data.photoPath == null || request.resource.data.photoPath is string)
          && (
            request.resource.data.pairId == resource.data.pairId
            || request.resource.data.pairId == null
            || (
              request.resource.data.pairId is string
              && getAfter(couplePath(request.resource.data.pairId)).data.status == 'active'
              && (
                getAfter(couplePath(request.resource.data.pairId)).data.memberA == uid
                || getAfter(couplePath(request.resource.data.pairId)).data.memberB == uid
              )
            )
          )
        )
        ||
        // A partner may only clear the other user's pairId as part of disconnect.
        (
          request.auth.uid != uid
          && resource.data.pairId is string
          && request.resource.data.pairId == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pairId', 'updatedAt'])
          && getAfter(couplePath(resource.data.pairId)).data.status == 'disconnected'
          && (
            getAfter(couplePath(resource.data.pairId)).data.memberA == request.auth.uid
            || getAfter(couplePath(resource.data.pairId)).data.memberB == request.auth.uid
          )
          && (
            getAfter(couplePath(resource.data.pairId)).data.memberA == uid
            || getAfter(couplePath(resource.data.pairId)).data.memberB == uid
          )
        )
      );

      allow delete: if false;
    }

    match /deviceTokens/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /pairingCodes/{code} {
      allow get: if signedIn()
        && (
          resource.data.creatorUid == request.auth.uid
          || (
            resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
          )
        );
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.creatorUid
        && code.matches('^[A-Z2-9]{4}-[A-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly([
          'creatorUid', 'status', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm');

      // The joiner may atomically accept a pending code and attach the couple.
      allow update: if signedIn()
        && request.auth.uid != resource.data.creatorUid
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.coupleId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedBy', 'coupleId']);

      allow delete: if signedIn() && request.auth.uid == resource.data.creatorUid;
    }

    match /couples/{coupleId} {
      allow get: if signedIn()
        && (
          resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid
        );
      allow list: if false;

      // The joiner creates the couple in the same transaction that accepts
      // the pairing code. getAfter() validates the atomic pairing state.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.memberB
        && request.resource.data.keys().hasOnly([
          'memberA', 'memberB', 'pairingCode', 'status', 'createdAt'
        ])
        && request.resource.data.memberA is string
        && request.resource.data.memberB is string
        && request.resource.data.memberA != request.resource.data.memberB
        && request.resource.data.pairingCode is string
        && request.resource.data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.acceptedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.coupleId == coupleId
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.creatorUid == request.resource.data.memberA;

      allow update: if signedIn()
        && (
          resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'active'
        && request.resource.data.status == 'disconnected';

      allow delete: if false;

      match /actions/{actionId} {
        allow list: if signedIn()
          && isCoupleMember(coupleId);

        allow get: if signedIn()
          && isCoupleMember(coupleId)
          && resource.data.recipientUid == request.auth.uid;

        allow create: if signedIn()
          && get(couplePath(coupleId)).data.status == 'active'
          && isCoupleMember(coupleId)
          && request.resource.data.keys().hasOnly([
            'type', 'senderUid', 'recipientUid', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid != request.auth.uid
          && (
            request.resource.data.recipientUid == get(couplePath(coupleId)).data.memberA
            || request.resource.data.recipientUid == get(couplePath(coupleId)).data.memberB
          )
          && request.resource.data.type == 'POKE';

        allow delete: if signedIn()
          && isCoupleMember(coupleId)
          && resource.data.recipientUid == request.auth.uid;

        allow update: if false;
      }
    }
  }
}
