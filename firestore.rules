rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'pairId', 'createdAt', 'updatedAt'])
        && request.resource.data.pairId == null;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'pairId', 'updatedAt'])
        && (
          request.resource.data.pairId == null
          || (
            exists(couplePath(request.resource.data.pairId))
            && (
              get(couplePath(request.resource.data.pairId)).data.memberA == uid
              || get(couplePath(request.resource.data.pairId)).data.memberB == uid
            )
          )
        );

      allow delete: if false;
    }

    match /pairingCodes/{code} {
      allow get: if signedIn()
        && (
          resource.data.creatorUid == request.auth.uid
          || (
            resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
          )
        );
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.creatorUid
        && code.matches(/^[A-Z2-9]{4}-[A-Z2-9]{4}$/)
        && request.resource.data.keys().hasOnly([
          'creatorUid', 'status', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm');

      // The joining device may consume a pending code exactly once.
      // The couple document must be created in the same transaction.
      allow update: if signedIn()
        && request.auth.uid != resource.data.creatorUid
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.coupleId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedBy', 'coupleId']);

      allow delete: if signedIn() && request.auth.uid == resource.data.creatorUid;
    }

    match /couples/{coupleId} {
      // A couple is readable only by one of its two members.
      allow get: if signedIn()
        && (
          resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid
        );
      allow list: if false;

      // The joining device creates the couple as part of the code-consumption transaction.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.memberB
        && request.resource.data.keys().hasOnly([
          'memberA', 'memberB', 'pairingCode', 'status', 'createdAt'
        ])
        && request.resource.data.memberA is string
        && request.resource.data.memberB is string
        && request.resource.data.memberA != request.resource.data.memberB
        && request.resource.data.pairingCode is string
        && request.resource.data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.acceptedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.coupleId == coupleId
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.creatorUid == request.resource.data.memberA;

      // Members may disconnect the relationship, but cannot rewrite who the members are.
      allow update: if signedIn()
        && (
          resource.data.memberA == request.auth.uid
          || resource.data.memberB == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'disconnected';

      allow delete: if false;
    }
  }
}
